{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://markharness.com/schema/requirement.schema.json",
  "title": "Requirement",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
    },
    "source": {
      "enum": [
        "native",
        "external"
      ]
    },
    "label": {
      "type": "string",
      "minLength": 1
    },
    "axis": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "description": {
      "type": "string"
    },
    "source_locator": {
      "type": "string",
      "minLength": 1
    },
    "source_revision": {
      "type": "string",
      "minLength": 1
    },
    "related_issues": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "uid": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
    }
  },
  "required": [
    "id",
    "source",
    "axis"
  ],
  "additionalProperties": false
}
