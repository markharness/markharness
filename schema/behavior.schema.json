{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://markharness.com/schema/behavior.schema.json",
  "title": "Behavior",
  "type": "object",
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "feature": { "type": "string", "minLength": 1 },
    "label": { "type": "string", "minLength": 1 },
    "axis": { "type": "array", "items": { "type": "string" } },
    "description": { "type": "string", "minLength": 1 },
    "procedures": {
      "description": "Common procedures this Behavior's Scenarios may reference by name via a Phase step's `use:` (ADR 0017 §2). No automatic insertion; a procedure may not reference another procedure. Empty object means none.",
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "steps": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          }
        },
        "required": ["steps"],
        "additionalProperties": false
      }
    },
    "uid": { "type": ["string", "null"], "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$" }
  },
  "required": ["id", "feature", "label", "axis", "description", "procedures"],
  "additionalProperties": false
}
