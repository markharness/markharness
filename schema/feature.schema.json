{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://markharness.com/schema/feature.schema.json",
  "title": "Feature",
  "type": "object",
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "requirement_ids": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "minItems": 1
    },
    "label": { "type": "string", "minLength": 1 },
    "axis": { "type": "array", "items": { "type": "string" } },
    "description": { "type": "string" },
    "forked_from": { "type": ["string", "null"] },
    "uid": { "type": ["string", "null"], "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$" }
  },
  "required": ["id", "requirement_ids", "label", "axis"],
  "additionalProperties": false
}
