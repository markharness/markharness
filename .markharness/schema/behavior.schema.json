{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://markharness.com/schema/behavior.schema.json",
  "title": "Behavior",
  "type": "object",
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "feature": { "type": "string", "minLength": 1 },
    "label": { "type": "string", "minLength": 1 },
    "axis": { "type": "array", "items": { "type": "string" } },
    "description": { "type": "string", "minLength": 1 },
    "preconditions": {
      "description": "Operations common to every Condition under this Behavior, executed before the Condition's own steps. Empty array means no shared precondition.",
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "uid": { "type": ["string", "null"], "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$" }
  },
  "required": ["id", "feature", "label", "axis", "description", "preconditions"],
  "additionalProperties": false
}
