{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://markharness.com/schema/condition.schema.json",
  "title": "Condition",
  "type": "object",
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "behavior": { "type": "string", "minLength": 1 },
    "label": { "type": "string", "minLength": 1 },
    "description": { "type": "string", "minLength": 1 },
    "steps": {
      "description": "This Condition's own operations, run after behavior.preconditions.",
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "additional_preconditions": {
      "description": "Additional preconditions specific to this Condition that its steps alone cannot establish. Empty array means none.",
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "uid": { "type": ["string", "null"], "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$" }
  },
  "required": ["id", "behavior", "label", "description", "steps", "additional_preconditions"],
  "additionalProperties": false
}
