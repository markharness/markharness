{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://markharness.com/schema/scenario.schema.json",
  "title": "Scenario",
  "type": "object",
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "behavior": { "type": "string", "minLength": 1 },
    "label": { "type": "string", "minLength": 1 },
    "description": { "type": "string", "minLength": 1 },
    "phases": {
      "description": "Ordered operations and checks (ADR 0017 §2). Array order is the execution order, not filename order. A Scenario is one TestCase (1 Scenario = 1 TestCase).",
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "steps": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "oneOf": [
                {
                  "properties": { "action": { "type": "string", "minLength": 1 } },
                  "required": ["action"],
                  "additionalProperties": false
                },
                {
                  "properties": { "use": { "type": "string", "minLength": 1 } },
                  "required": ["use"],
                  "additionalProperties": false
                }
              ]
            }
          },
          "results": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          }
        },
        "required": ["steps", "results"],
        "additionalProperties": false
      }
    },
    "implementation_note": {
      "description": "Implementation rationale. Not used for generation.",
      "type": "string",
      "minLength": 1
    },
    "generated_by": {
      "description": "How this Scenario's content was produced. Omitted means unknown, not 'manual'.",
      "enum": ["manual", "llm", "auto_combination"]
    },
    "verified_by": {
      "description": "Human review gate. Omitting the whole field means not (yet) reviewed.",
      "type": "object",
      "properties": {
        "human_review": { "type": "boolean" }
      },
      "required": ["human_review"],
      "additionalProperties": false
    },
    "uid": { "type": ["string", "null"], "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$" }
  },
  "required": ["id", "behavior", "label", "description", "phases"],
  "additionalProperties": false
}
