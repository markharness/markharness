{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://markharness.com/schema/expected_result.schema.json",
  "title": "ExpectedResult",
  "type": "object",
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "condition": { "type": "string", "minLength": 1 },
    "description": { "type": "string", "minLength": 1 },
    "generated_by": {
      "description": "How this ExpectedResult's content was produced. Omitted means unknown, not 'manual'.",
      "enum": ["manual", "llm", "auto_combination"]
    },
    "verified_by": {
      "description": "Human review gate. Omitting the whole field means not (yet) reviewed.",
      "type": "object",
      "properties": {
        "human_review": { "type": "boolean" }
      },
      "required": ["human_review"],
      "additionalProperties": false
    },
    "uid": { "type": ["string", "null"], "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$" }
  },
  "required": ["id", "condition", "description"],
  "additionalProperties": false
}
